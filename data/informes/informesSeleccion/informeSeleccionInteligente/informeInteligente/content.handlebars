            // Patrones de continuidad
            this.continuityPatterns = {
                'header-content': 0.8,     // Header debe tener 80% de su contenido
                'similar-elements': 0.6,   // Elementos similares juntos
                'module-coherence': 0.9    // Coherencia de módulo completo
            };
