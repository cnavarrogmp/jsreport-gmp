                    allowSplit: false
                },
                'competency-cards': {
                    maxGroupSize: 4,        // Máximo 4 competencias por grupo
                    minGroupSize: 2,
                    keepWithHeader: true,
                    allowSplit: false       // Las tarjetas deben ir completas
                },
                'reference-items': {
                    maxGroupSize: 4,
